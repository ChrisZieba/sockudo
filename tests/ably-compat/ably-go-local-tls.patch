+type localPlaintextTransport struct {
+	base http.RoundTripper
+}
+
+func (transport localPlaintextTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	hostname := request.URL.Hostname()
+	ip := net.ParseIP(hostname)
+	if hostname != "localhost" && (ip == nil || (!ip.IsLoopback() && !ip.IsUnspecified())) {
+		return nil, fmt.Errorf("refusing plaintext REST test transport for non-loopback host %q", hostname)
+	}
+	request = request.Clone(request.Context())
+	request.URL.Scheme = "http"
+	return transport.base.RoundTrip(request)
+}
