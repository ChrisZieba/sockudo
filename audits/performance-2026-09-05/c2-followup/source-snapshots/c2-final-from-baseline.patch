+    pub(super) data_len: i64,
+    /// Referenced by an idempotency receipt; receipts are never purged, so
+    /// neither is a snapshot a duplicate replay reconstructs from.
+    pub(super) pinned: bool,
+    pub(super) updated_at_ms: i64,
