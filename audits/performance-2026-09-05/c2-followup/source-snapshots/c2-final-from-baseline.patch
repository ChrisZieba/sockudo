+                    .bind(row.get::<String, _>("version_serial"))
+                    .bind(payload.as_slice())
+                    .execute(&self.pool)
+                    .await
+                    .map_err(|e| Error::Internal(format!("failed to rewrite compact entry: {e}")))?
+                    .rows_affected();
+            }
+            if (rows.len() as i64) < limit {
+                break;
+            }
+        }
+        Ok(rewritten)
+    }
+}
